# =============================================
# 安全防护规则
# =============================================

# 禁止访问敏感目录和文件
RedirectMatch 403 /database/.*$
RedirectMatch 403 /sessions/.*$
RedirectMatch 403 /logs/.*$
RedirectMatch 403 /config/.*$
RedirectMatch 403 /includes/.*$

# 禁止访问备份/临时文件
RedirectMatch 403 /\.(bak|tmp|old|log)$

# 防止目录浏览
Options -Indexes

# 默认字符集
AddDefaultCharset UTF-8
